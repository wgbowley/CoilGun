[version]
format: 0.1.0
unit_frame: units.ut

[notes]
# Analytical model for a multi-stage coil-gun via rk_2nd methods for currents
# and explicit euler for motional dynamics.

# Assume the coil is made of a material that has a permeability approximately
# equal to free space.

[model]
number_stages: 10
time_steps: 50 u(s)

stage_gap: 10 m(m)
voltage: 18 (V)
battery_esr: 250 m(Ω)
atmospheric_density: 1.225 (kg/m^3)
relative_permeability: 1.0


[projectile]
radius: 4.5 m(m)
axial_length: 45 m(m)
coefficient_drag: 0.82

density: 7872 (kg/m^3)
magnetic_hysteresis: [
  [0.000000, 0.000000],
  [0.227065, 13.898400],
  [0.454130, 27.796700],
  [0.681195, 42.397400],
  [0.908260, 61.415700],
  [1.135330, 82.382400],
  [1.362390, 144.669000],
  [1.589350, 897.760000],
  [1.812360, 4581.740000],
  [2.010040, 17736.200000],
  [2.133160, 41339.300000],
  [2.199990, 68321.800000],
  [2.254790, 95685.500000],
  [2.299930, 123355.000000],
  [2.342510, 151083.000000],
  [2.378760, 178954.000000],
  [2.415010, 206825.000000],
  [2.451260, 234696.000000],
  [2.487500, 262568.000000],
  [2.523750, 290439.000000],
  [2.560000, 318310.000000]
] (T), (A_m)

# Field warping parameters
alpha: 1
beta: 0.6


[coil]
axial_length: 50 m(m)
outer_radius: 17.5 m(m)
inner_radius: 6.25 m(m)
wire_diameter: 1.25 m(m)
fill_factor: 0.7

resistivity: 16.8 n(Ω*m)
